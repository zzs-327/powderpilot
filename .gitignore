# ============================================================
# 仓库根 .gitignore
# 注意：.env 绝对不能进仓库（里面是 API key 和数据库密码）
# ============================================================

# ---- 密钥 ----
.env
# docker compose 用的环境文件（里面是数据库密码与 API key）
.env.docker
*.key
*.pem

# ---- 编辑器 / IDE ----
.idea/
.vscode/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ---- 运行期产物（向量库 / 会话记忆 / 数据库文件） ----
chroma/
checkpoints.db
*.db
*.sqlite3
# SQLite WAL 模式会额外产生 -shm / -wal 两个文件，别漏了
*.db-shm
*.db-wal

# ---- 前端 ----
node_modules/
unpackage/
dist/

# ---- 实拍图原图不入库，只提交元数据 ----
ski-backend/data/photos/*
!ski-backend/data/photos/.gitkeep

# ---- 排障产物（根目录的截图 / 数组 / 分割结果，只留在本地） ----
/*.png
/*.npy
/seg.json
chroma_probe*/

# ---- AI 工作记忆（会话级，不进仓库） ----
.workbuddy/

# ---- 系统 ----
.DS_Store
Thumbs.db

# ---- 公开快照导出目录（生成物，不入库）----
.public-export/

# ��ʱ git bundle ����Ŀ¼��˽�вֿ�����󣬱���汾�⣩
.bundle-tmp/

# diagnostic / runtime logs (never commit; export_public skips gitignored files)
*.log
logs/
_tmp_diag/
private/acl-recovery/

# 参考图与裁剪副本（第三方图片，不随仓库分发）
.terrain-reference/
