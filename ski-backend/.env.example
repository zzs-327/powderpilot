# 复制为 .env 后填写自己的值：cp .env.example .env
DATABASE_URL=mysql+pymysql://USER:YOUR_PASSWORD@127.0.0.1:3306/ski_db?charset=utf8mb4
SECRET_KEY=
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=True
# CORS 白名单（逗号分隔）。本地开发用 *；部署必须填前端域名——
# 中间件是 allow_credentials=True，而浏览器不接受带凭证请求里的通配符来源，
# 不填会出现"CORS 配了但带 cookie 的请求失败"这种难查的问题
ALLOW_ORIGINS=*

LLM_PROVIDER=zhipu
ZHIPU_API_KEY=
# 模型可换：glm-4.5-air（赠送包常有额度，默认）/ glm-4-flash（完全免费，效果打折）/
# glm-5.3-flash（效果好，收费，但见下面 LLM_THINKING 的坑）
# 报 429「余额不足或无可用资源包」= 这个模型没额度了（赠送包是**按模型**给的，
# 去 控制台 → 财务 → 资源包 看哪个包里还有 token），换一行即可，代码不用动
LLM_MODEL=glm-4.5-air
# GLM-4.5 / 4.6 系列默认"先想再答"，**必须关掉**：实测开着思考时一次调用 2 秒
# 只吐思考过程（content 为空），关掉 0.6 秒给答案；Agent 一轮要调好几次模型，
# 不关会慢到几分钟。不支持的模型留空即可。
#
# ⚠️ 2026-10-03 实测：glm-5.3-flash **始终思考、不支持关闭**，配 disabled 会直接 400：
#     该模型始终思考，不支持关闭思考；请使用 low、high 或 max。
#    用这个模型请把下面改成 LLM_THINKING=low，否则每一次模型调用都失败。
LLM_THINKING=disabled
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_TEMPERATURE=0.3

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=shaw/dmeta-embedding-zh:latest
# 向量库集合名。config 里的默认值是历史遗留的 ski_kb（那个集合已经损坏，见
# docs/TROUBLESHOOTING.md #24），新环境务必带上这一行，否则会去开一个打不开的集合
CHROMA_COLLECTION=ski_kb_quality_v2
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80

USE_STRUCTURED_OUTPUT=True

RETRIEVE_TOP_K=10
RRF_K=60
RERANK_TOP_N=5
MAX_DISTANCE=0.85

# 中间件栈（Agent 护栏）：官方件 + 自研件
#   官方：工具失败重试 / 上下文超长摘要
#   自研：证据编号全轮唯一 / 引用与数字后置校验 / 历史裁剪兜底
# 设为 False 可做对照实验（同一条问题，有护栏 vs 没护栏）
USE_MIDDLEWARE=True

# 上下文管理是两级的：摘要是一级（正常路径），裁剪是二级（保险丝）
# 裁剪阈值务必远高于摘要保留条数，否则会把摘要要用的历史提前删掉
# 12000 是实测标定的：本项目系统提示词长，一句"你好"就要 3669 tokens，
# 第二轮带证据 6762——填 4000 会让第二句就开始摘要，白烧模型调用
SUMMARY_TRIGGER_TOKENS=12000
SUMMARY_KEEP_MESSAGES=10
HISTORY_HARD_LIMIT=40

BAIDU_MAP_AK=
QWEATHER_KEY=

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_PHOTOS=ski-photos
MINIO_PUBLIC_BASE_URL=http://127.0.0.1:9000

# ---------------- 嵌入服务（可选）----------------
# ollama（默认，本地）/ openai（任何 OpenAI 兼容的 /embeddings 服务，例如百炼、硅基流动）
EMBED_PROVIDER=ollama
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=
