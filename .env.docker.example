# docker compose 用的环境文件（复制成 .env.docker 后填写）
#
#   cp .env.docker.example .env.docker
#   docker compose --env-file .env.docker up -d --build
#
# ⚠️ .env.docker 已在 .gitignore 里忽略，**不要提交**
# ⚠️ 和后端自己的 ski-backend/.env 不是同一个文件：这个是给 compose 做变量替换用的

# MySQL root 密码（compose 会用它初始化容器，并拼进 DATABASE_URL）
MYSQL_ROOT_PASSWORD=

# JWT 签名密钥（生产必须换成随机串：openssl rand -hex 32）
SECRET_KEY=

# 大模型（智谱）。LLM_MODEL 别用 glm-5.3-flash：它始终思考、不支持关闭，会 400
LLM_PROVIDER=zhipu
ZHIPU_API_KEY=
LLM_MODEL=glm-4.5-air
LLM_THINKING=disabled
DEEPSEEK_API_KEY=

# CORS 白名单：部署时填前端域名，例如 https://ski.example.com
# 留 * 只适合本地/演示；公网部署建议显式列出
ALLOW_ORIGINS=*

# ---------------- 嵌入服务（可选：部署到小内存服务器时用它替代 Ollama）----------------
# 默认 ollama（本地，零成本）。改成 openai 后可用任何 OpenAI 兼容的 /embeddings 服务，
# 服务器上就不必再跑 Ollama（省 1~2GB 内存与全部 CPU）：
#   EMBED_PROVIDER=openai
#   EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   # 阿里云百炼
#   EMBED_MODEL=text-embedding-v4
#   EMBED_API_KEY=sk-xxx
# ⚠️ 换嵌入模型 = 维度变了：必须重建向量库（python -m rag.ingest --rebuild）并重跑评估
EMBED_PROVIDER=ollama
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=
